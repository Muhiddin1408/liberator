# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring. .env git'ga qo'shilmaydi.

# --- Asosiy ---
# Lokal kompyuterda: DEBUG=True va SITE_URL=http://127.0.0.1:8000. Serverda: DEBUG=False.
DEBUG=False
# Yangi kalit: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=liberator.uz,www.liberator.uz
CSRF_TRUSTED_ORIGINS=https://liberator.uz,https://www.liberator.uz
SITE_URL=https://liberator.uz
# Admin panel manzili (standart "admin/" o'rniga — taxmin qilib bo'lmaydigan nom tanlang)
ADMIN_URL=admin/
# nginx orqasida ishlasa 1
NUM_PROXIES=1

# --- Fayllar (ixtiyoriy) ---
# SQLITE_PATH=/srv/liberator/db.sqlite3
# CACHE_DIR=/srv/liberator/var/cache

# --- Murojaat xabarnomalari ---
LEAD_NOTIFY_EMAILS=Liberator.inbox@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
# Gmail uchun "App password" ishlating, oddiy parol emas
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# @BotFather dan olingan token va xabar boradigan chat/guruh ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEAD_RATE_LIMIT_PER_HOUR=5

# --- Analitika va tasdiqlash kodlari (bo'sh bo'lsa ulanmaydi) ---
YANDEX_METRIKA_ID=
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
MAILRU_VERIFICATION=aZNDKB74xxnYK3qG
